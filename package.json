{
  "name": "great-expectations",
  "author": "Brian Watkins",
  "license": "MIT",
  "version": "1.12.0",
  "description": "Write type-aware expectations for testing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brian-watkins/great-expectations.git"
  },
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist/",
    "skills/"
  ],
  "scripts": {
    "fix:cjs": "cp ./cjs_package.json ./dist/cjs/package.json",
    "prepublishOnly": "npm run build",
    "build": "rm -rf dist && tsc -p ./tsconfig.json && tsc -p ./tsconfig-cjs.json && npm run fix:cjs",
    "test:types": "tsc -p ./behaviors/tsconfig.json",
    "test:behaviors": "tsx ./behaviors/runner.ts",
    "test": "npm run test:types && npm run test:behaviors"
  },
  "devDependencies": {
    "@types/deep-equal": "^1.0.4",
    "@types/node": "^24.12.2",
    "esbehavior": "^8.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.15.0"
  },
  "dependencies": {
    "deep-equal": "^2.2.3"
  }
}
